APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres@localhost:5432/testflowai

# App login gate (src/components/AuthGate.tsx + server/features/auth/routes.ts)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Encryption key for secrets at rest (website-user passwords + private-repo access tokens).
# 32 bytes of randomness. Rotating this makes existing stored secrets undecryptable
# (they must be re-entered). Keep it out of source control.
CRED_ENC_KEY=generate-a-32-byte-random-secret

# ===== Default target (fallback only) =====
# Each app sets its OWN base URL + credentials in the wizard; these globals are just a
# fallback default target for local dev when no app is selected.
# How the catalog is built for grounding (per-app overrides this):
#   swagger -> derive from the app's OpenAPI spec (no DB, no leakage) [recommended]
#   api     -> the app's objects API (business objects only)
CATALOG_SOURCE=swagger
TARGET_BASE_URL=http://localhost:3000
TARGET_SPEC_PATH=/openapi.json
# Auth to read records/business-object names. Prefer a token in prod.
TARGET_USERNAME=your-target-username
TARGET_PASSWORD=your-target-password
# TARGET_TOKEN=read-only-token            # use instead of username/password in prod

# Source repo of the target (used for the source-grounding fallback)
TARGET_REPO_PATH=D:\\path\\to\\target-repo
DRAFTING_SKILL_PATH=D:\\path\\to\\drafting-skill
AGENT_SKILL_PATH=D:\\path\\to\\agent-skill

INSPECTOR_MCP=0

AGENT_INVESTIGATE=0
AGENT_ANALYST=0
VISUAL_REGRESSION=0
# Record & Play — local desktop agent (enabled to preview the Automation UI)
REMOTE_AGENT_V1=0

# Codex runtime — every agent turn runs here.
# Auth: leave OPENAI_API_KEY empty to use the machine's ChatGPT login ("codex login"),
# or set a key to run in API-key mode (billed per token, tracked by the cost tracker).
OPENAI_API_KEY=
# Path to the codex binary when it is not on PATH.
CODEX_CLI_PATH=
# Migration rollback: auto uses SDK for ordinary turns and App Server for MCP approvals.
# Use app-server for immediate rollback, or sdk to reject unsupported MCP turns explicitly.
CODEX_TRANSPORT=auto
# Where Codex stores credentials. In a container point this at a MOUNTED VOLUME, or the
# ChatGPT sign-in is lost on every redeploy. Defaults to ~/.codex.
CODEX_HOME=
# How long an unused device-code sign-in stays valid (default 15m).
CODEX_LOGIN_TTL_MS=
# App-server tuning. Defaults: 30s per request, 15m per turn, 5m idle shutdown.
CODEX_APP_SERVER_TIMEOUT_MS=
CODEX_TURN_TIMEOUT_MS=
CODEX_APP_SERVER_IDLE_MS=
# Scoped MCP bridge (how Codex reaches application tools). Loopback-only; port 0 = ephemeral.
CODEX_MCP_PORT=
CODEX_MCP_SESSION_TTL_MS=
CODEX_MCP_MAX_RESULT_CHARS=

# Local stability: serialize Chromium startups (parallel inits crash on this machine)
CHROMIUM_MAX_CONCURRENT_LAUNCHES=1

# Vitals reads the observability (obs) schema of the product under test directly.
#
# NONE OF THIS IS REQUIRED. Vitals is normally connected from the UI (Vitals -> Connect), which
# stores the connection encrypted in this app's own settings and applies it without a restart.
# These variables are a fallback for deployments that prefer config-as-deployment; anything saved
# in the UI takes precedence over them.
#
# Full connection (any server; add ?sslmode=require when it is not local):
#   VITALS_DATABASE_URL=postgres://user:password@host:5432/database
# Shorthand when that schema is on the same Postgres as this app — name the database instead:
#   VITALS_DB_NAME=core-platform
#
# Optional control plane: the monitored product's own console. Only needed to START load and
# security runs from the Load Lab; every read works without it.
#   VITALS_CONTROL_URL=https://product.example.com
#   VITALS_CONTROL_USERNAME=operator
#   VITALS_CONTROL_PASSWORD=...
